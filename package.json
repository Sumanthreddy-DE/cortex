{
  "name": "cortex",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop command center for links, ideas, and notes.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
