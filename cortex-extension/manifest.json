{
  "manifest_version": 3,
  "name": "Cortex",
  "version": "1.0.0",
  "description": "Save the current tab to Cortex — your local link and idea manager.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["http://127.0.0.1:51204/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Cortex"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current tab to Cortex"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
